# 宿主机路径映射（必填，根据你的实际路径修改）
DOWNLOAD_PATH=/your/download/path
MEDIA_PATH=/your/media/path
FAILED_PATH=/your/failed/path
DATA_PATH=/your/data/path

# AcoustID API Key（可选，留空则完全禁用声纹匹配）
# 免费申请：https://acoustid.org/login
ACOUSTID_API_KEY=

# Discogs API Key（可选，留空则自动禁用 Discogs 刮削）
DISCOGS_API_KEY=

# Web 管理员密码（留空则自动生成随机密码，可在日志中查看）
WEBUI_PASSWORD=